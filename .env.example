# Variables de PRODUCCIÓN. Este archivo se copia como `.env` **en la VM**, al lado de
# `docker-compose.prod.yml`, y lo leen los tres servicios.
#
# No confundir con `backend/.env.example`, que es el de desarrollo y documenta la misma app
# corriendo contra el Postgres del `docker-compose.yml` de acá al lado. La diferencia de
# fondo es que este archivo incluye además las credenciales del contenedor Postgres, que en
# desarrollo están escritas adentro del compose.

# --- Postgres ---
# Las leen el contenedor `db` (para crear la base la primera vez) y el healthcheck del
# compose. La contraseña se elige una vez y no se vuelve a tocar: cambiarla acá después del
# primer arranque no cambia la del Postgres ya inicializado, solo rompe la conexión.
POSTGRES_USER=factumov
POSTGRES_PASSWORD=
POSTGRES_DB=factumov

# El host es `db`: el nombre del servicio en el compose. No hay puerto publicado, así que
# desde afuera de la red del compose esta URL no resuelve — que es la idea.
DATABASE_URL=postgresql+psycopg://factumov:<la misma de arriba>@db:5432/factumov

# --- Logs ---
# Nivel del logger `factumov`. El root queda siempre en WARNING, así que esto no prende el
# INFO de zeep ni de SQLAlchemy: prende el de la app, que es donde el trabajo de fondo cuenta
# lo que hizo (el barrido de delegaciones, sin ir más lejos). Con WARNING solo se ven los
# fallos, o sea que un barrido que anda y uno que no arrancó se ven igual. `debug` para una
# sesión de diagnóstico y nada más.
LOG_LEVEL=INFO

# --- Mail transaccional ---
# Sin esto no se puede registrar una cuenta ni recuperar una contraseña. La app arranca
# igual, pero deja un ERROR en el log al levantar: `docker compose logs app | grep -i mail`.
# El 465 se rechaza al leer la config: este transporte abre siempre texto plano + STARTTLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
# Van los dos o ninguno.
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=FactuMov <no-reply@insoft.net.ar>

# De acá cuelgan el link de confirmación y el de reset que salen por mail. Con el dominio
# real y con https://, que es lo que termina srv-nginx.
APP_BASE_URL=https://factumov.insoft.net.ar

# A quién le llegan los dos avisos que no le van a ningún usuario:
#  - alguien se registró;
#  - un usuario dice "ya delegué" y ARCA todavía no nos habilita, o sea que falta aceptar su
#    designación en el Administrador de Relaciones con la Clave Fiscal de FactuMov. Ese click
#    no lo expone ningún web service, así que sin este mail nadie se entera de que hay
#    alguien esperando.
# Vacío es válido y los avisos quedan en el log.
OPERATOR_EMAIL=miguelsalvati@gmail.com

# --- ARCA ---
# **La variable más cara del archivo.** Con `prod`, cada emisión es un comprobante con
# validez legal a nombre de un CUIT real y no hay vuelta atrás: se deja sin efecto con una
# nota de crédito, que FactuMov no emite. El botón de emitir de la app es, a partir de acá,
# irreversible hacia afuera.
ARCA_ENV=prod

# Rutas **del contenedor**: el compose monta ./certs de la VM en /app/certs de solo lectura.
#
# Es el certificado **propio de FactuMov**, no el de Balance360, aunque los dos sean del
# mismo CUIT (`20182810674`). Compartirlo es lo que deja a una de las dos apps afuera de
# ARCA hasta doce horas — la sección 7 del DEPLOYMENT cuenta por qué y cómo se saca el
# propio. Si los subís con otro nombre, ajustá estas dos líneas.
#
# Mientras estos dos archivos no existan en ~/FactuMov/certs, todo lo que salga a ARCA
# contesta 502 con un ArcaError que los nombra. Es el guardarraíl que impide emitir con el
# certificado de Balance360 sin darse cuenta, no un bug.
#
# `factumov.crt` es el de PRODUCCIÓN; `factumov-homo.crt` es el de homologación y se le
# parece. Se distinguen por el emisor, no por el nombre del archivo:
#   openssl x509 -in factumov.crt -noout -issuer
#   CN=Computadores       -> producción, emite de verdad
#   CN=Computadores Test  -> homologación
ARCA_CERT_PATH=/app/certs/factumov.crt
ARCA_PRIVATE_KEY_PATH=/app/certs/factumov.key

# Cache de los WSDL. Apunta al volumen `wsdl_cache`, así sobrevive al deploy.
ARCA_WSDL_CACHE_PATH=/var/cache/factumov/wsdl.db

# --- Integración con Balance360 ---
# A qué Balance360 le habla este servidor. Es config y no un campo del formulario: quien sabe
# en qué host corre la otra app es quien deployó las dos, no la persona que aprieta "conectar".
# Con esquema (http:// o https://); la barra final da igual, se normaliza.
#
# **Vacía es válido**: la app arranca igual y la pantalla de Ajustes dice que la integración no
# está configurada en este servidor, nombrando esta variable.
BALANCE360_BASE_URL=https://balance360.insoft.net.ar

# Clave con la que se cifran los tokens de API que Balance360 emite cuando el usuario conecta
# su cuenta. Es el único secreto ajeno que la app tiene que poder **volver a leer** —hay que
# mandarlo en cada request—, así que no se puede hashear como la contraseña o la sesión; el
# porqué del cifrado está en `services/secrets.py`.
#
# Se genera con:
#     uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# **Vacía es válido**: la app arranca igual y todo lo demás anda, pero la pantalla de Ajustes
# avisa que el servidor no puede guardar tokens. Perderla tampoco es grave: los tokens
# guardados dejan de abrirse y cada usuario vuelve a conectar, que emite uno nuevo y revoca el
# que quedó ilegible.
SECRET_ENCRYPTION_KEY=

# --- Cobro con Mercado Pago ---
# Las credenciales con las que este servidor crea el checkout de la suscripción y acredita lo
# que se cobra. **Vacías es válido**: la app arranca igual y lo único que no anda es el pago,
# que la pantalla del plan lo dice nombrando la variable que falta.
#
# Son dos secretos distintos y hacen cosas distintas. El access token sirve para *hablarle* a
# Mercado Pago —crear el `preapproval`, cancelarlo, leer un cobro—; el del webhook sirve para
# *verificar* que la notificación que llega viene de ellos.
#
# El access token sale de https://www.mercadopago.com.ar/developers → tu aplicación →
# Credenciales. **Ojo con cuál se copia**: las de producción cobran plata de verdad y las de
# prueba no, y son visualmente iguales salvo por el prefijo `TEST-`. Este archivo es el de
# producción, así que acá va la productiva.
MERCADOPAGO_ACCESS_TOKEN=
#
# El secreto de la firma se genera en el mismo panel, en Webhooks y en la pestaña "Modo
# productivo", al dar de alta la URL de notificaciones. **La URL que hay que cargar ahí es**:
#     https://factumov.insoft.net.ar/api/webhooks/mercado-pago
# y el único evento que hay que tildar es "Planes y suscripciones", que es como el panel agrupa
# hoy a `subscription_preapproval` y `subscription_authorized_payment` — los dos que la app
# atiende. Los demás llegan y se ignoran. El modo de prueba tiene su propia URL y su propia
# clave: dar de alta una no configura la otra.
#
# Sin este secreto **no se procesa ninguna notificación**: el endpoint no tiene sesión —lo
# llama un servidor de Mercado Pago— así que la firma es toda su autenticación, y del otro
# lado hay algo que escribe "esta cuenta es Pro". Un servidor sin el secreto contesta 503 y
# Mercado Pago reintenta el aviso, así que ponerlo tarde no pierde los cobros de ese rato.
MERCADOPAGO_WEBHOOK_SECRET=
