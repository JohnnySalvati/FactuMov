# Plantilla de variables de entorno.
# Copiá este archivo como .env y completá los valores reales.
# El .env real NO se versiona (está en .gitignore).
#
# Acá va SOLO lo que lee la app. Las credenciales del contenedor Postgres
# viven en docker-compose.yml, no acá.

# Puerto 5433 a propósito: el 5432 ya lo usa Balance360.
DATABASE_URL=postgresql+psycopg://factumov:factumov@localhost:5433/factumov

# Opcional — base separada para los tests.
# DATABASE_TEST_URL=postgresql+psycopg://factumov:factumov@localhost:5433/factumov_test
