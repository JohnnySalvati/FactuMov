# Plantilla de variables de entorno.
# Copiá este archivo como .env y completá los valores reales.
# El .env real NO se versiona (está en .gitignore).
#
# Acá va SOLO lo que lee la app. Las credenciales del contenedor Postgres
# viven en docker-compose.yml, no acá.

# Puerto 5433 a propósito: el 5432 ya lo usa Balance360.
DATABASE_URL=postgresql+psycopg://factumov:factumov@localhost:5433/factumov

# Opcional — base separada para los tests.
DATABASE_TEST_URL=postgresql+psycopg://factumov:factumov@localhost:5433/factumov_test

# --- Mail transaccional (registro y confirmación) ---
# Server SMTP. El default es STARTTLS en 587, que es lo que usan Gmail y la mayoría.
# Para el puerto 465 (TLS implícito) hay que poner SMTP_STARTTLS=false.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
# Con Gmail: SMTP_USER es la dirección completa y SMTP_PASSWORD es una "app password"
# (Cuenta de Google → Seguridad → Verificación en dos pasos → Contraseñas de aplicación).
# La contraseña normal no funciona.

# Remitente de los mails. Con Gmail tiene que coincidir con SMTP_USER.
EMAIL_FROM=FactuMov <no-reply@factumov.example>

# Base de la SPA: de acá cuelga el link de confirmación que sale en el mail.
APP_BASE_URL=http://localhost:5173

# CUIT del certificado de FactuMov, el que el usuario autoriza en ARCA. Todavía no
# existe. Dejarlo comentado deja salir el placeholder; ponerlo vacío lo pisa con un
# string vacío y el mail queda con un hueco en vez de con un aviso.
# ARCA_DELEGATE_TAX_ID=20-12345678-9

# --- ARCA (WSAA + WSFE + padrón) ---
# Entorno. "homo" es homologación y es el default: si la variable falta, la app pega
# contra el ARCA de pruebas y no contra el real. Equivocarse hacia homologación es
# gratis; al revés no.
ARCA_ENV=homo

# Certificado y clave privada de FactuMov. Es UN solo certificado para toda la app: los
# usuarios no suben el suyo, lo autorizan (delegación) desde el portal de ARCA.
# El de homologación y el de producción son distintos y hay que cambiarlos junto con
# ARCA_ENV.
ARCA_CERT_PATH=
ARCA_PRIVATE_KEY_PATH=

# Dónde cachea zeep los WSDL. Sin esto usa el temp del sistema, que en un contenedor
# efímero se pierde en cada deploy y obliga a bajar los WSDL de nuevo.
# ARCA_WSDL_CACHE_PATH=/var/cache/factumov/wsdl.db
